  </body>
  <body name="FabConvert.com_servo_brackets_x4">
    <geom mesh="FabConvert.com_servo_brackets_x4" class="visual"/>
    <geom mesh="FabConvert.com_servo_brackets_x4" class="collision"/>
  </body>
  <body name="FabConvert.com_middle_wall_mount">
    <geom mesh="FabConvert.com_middle_wall_mount" class="visual" axisangle="1 0 0 90" pos="0.1 0.2 0.3"/>
