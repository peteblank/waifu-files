<mujoco model="FabConvert.com_back_ring_holder">
  <default>
    <default class="visual">
      <geom group="2" type="mesh" contype="0" conaffinity="0"/>
    </default>
    <default class="collision">
      <geom group="3" type="mesh"/>
    </default>
  </default>
  <asset>
    <mesh file="FabConvert.com_servo_gear_x2.obj"/>
    <mesh file="FabConvert.com_servo_brackets_x4.obj"/>
    <mesh file="FabConvert.com_middle_wall_mount.obj"/>
    <mesh file="FabConvert.com_gear_2.obj"/>
    <mesh file="FabConvert.com_gear_1.obj"/>
    <mesh file="FabConvert.com_back_ring_holder.obj"/>
    <mesh file="FabConvert.com_back_cover_sphere.obj"/>
  </asset>
<worldbody>
  <body name="FabConvert.com_servo_gear_x2">
