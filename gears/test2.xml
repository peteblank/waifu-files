  </body>
  <body name="FabConvert.com_back_cover_sphere2">
    <geom mesh="FabConvert.com_back_cover_sphere" class="visual" rgba="1 1 1 0.1" axisangle="1 0 0 180" pos="0.2 -0.1 0.3"/>
    <geom mesh="FabConvert.com_back_cover_sphere" class="collision" axisangle="1 0 0 180" pos="0.2 -0.1 0.3"/>
  </body>
</worldbody>
</mujoco>